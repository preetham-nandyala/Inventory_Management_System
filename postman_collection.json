							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"name\": \"\",\n    \"sku\": \"\",\n    \"category\": \"\",\n    \"price\": 10,\n    \"quantity\": 5\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/products",
							"host": ["{{baseUrl}}"],
							"path": ["products"]
						},
						"description": "Attempt to create a product with empty required fields. Expected: 400 error."
					},
					"response": []
				},
				{
					"name": "Create Product - Invalid Price (Should Fail)",
					"request": {
