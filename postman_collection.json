{
	"info": {
		"_postman_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
		"name": "Product Inventory Management System",
		"description": "API collection for the Product Inventory Management System. Covers all CRUD operations for products and stock management endpoints.\n\n**Base URL:** http://localhost:5000/api\n\n**Setup:**\n1. Start the backend server: `cd backend && npm run dev`\n2. Make sure the database is set up: `npm run db:setup`",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:5000/api",
			"type": "string"
		},
		{
			"key": "productId",
			"value": "1",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "Products CRUD",
			"description": "Create, Read, Update, and Delete operations for products.",
			"item": [
				{
					"name": "Create Product",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"name\": \"Gaming Monitor\",\n    \"sku\": \"GM-011\",\n    \"category\": \"Electronics\",\n    \"price\": 349.99,\n    \"quantity\": 25,\n    \"low_stock_threshold\": 5\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/products",
							"host": ["{{baseUrl}}"],
							"path": ["products"]
						},
						"description": "Add a new product to the inventory.\n\n**Required fields:** name, sku, category, price, quantity\n**Optional fields:** low_stock_threshold (defaults to 10)\n\n**Validations:**\n- SKU must be unique\n- Price must be a positive number\n- Quantity must be a non-negative integer\n- Name, SKU, and Category must not be empty"
					},
					"response": []
				},
				{
					"name": "Create Product - Duplicate SKU (Should Fail)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"name\": \"Another Mouse\",\n    \"sku\": \"WM-001\",\n    \"category\": \"Electronics\",\n    \"price\": 19.99,\n    \"quantity\": 10\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/products",
							"host": ["{{baseUrl}}"],
							"path": ["products"]
						},
						"description": "Attempt to create a product with a duplicate SKU. Expected: 400 error with message about duplicate SKU."
					},
					"response": []
				},
				{
					"name": "Create Product - Missing Fields (Should Fail)",
					"request": {
